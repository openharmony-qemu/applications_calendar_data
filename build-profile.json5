{
  "app": {
    "products": [
      {
        "name": "default",
        "compileSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": 23,
        "runtimeOS": "OpenHarmony"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "common",
      "srcPath": "./common"
    },
    {
      "name": "datastructure",
      "srcPath": "./datastructure"
    },
    {
      "name": "datamanager",
      "srcPath": "./datamanager"
    },
    {
      "name": "rrule",
      "srcPath": "./rrule"
    },
    {
      "name": "dataprovider",
      "srcPath": "./dataprovider"
    }
  ]
}
